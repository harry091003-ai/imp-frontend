# Everything starting with VITE_ ends up in the public browser bundle. Never put a secret here.
# To change a value, copy the line into a file named .env.local (Git ignores it).

# Base path of the API. Same origin: Vite (dev) and nginx (production) forward it to the gateway.
VITE_API_BASE_URL=/api

# The backend sends times with no timezone, in the server's own clock. This says which clock that is.
# Production servers should run in UTC. On a laptop in India, use +05:30.
VITE_SERVER_UTC_OFFSET=+00:00

# THE switch between sample data and your real backend, for development only.
# true = sample data. false = the real gateway on 127.0.0.1:8082.
# Production builds always use the real backend, whatever this says.
VITE_API_MOCKING=true
